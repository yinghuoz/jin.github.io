        <title>FLY TO THE GALAXY｜飞向银河</title>
        <link>http://localhost:1313/jin.github.io/music/fly-to-the-galaxy.md/</link>
        <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
        
        <guid>http://localhost:1313/jin.github.io/music/fly-to-the-galaxy.md/</guid>
        <description>&lt;div class=&#34;galaxy-player&#34;&gt;
  &lt;h1&gt;FLY TO THE GALAXY&lt;/h1&gt;
  &lt;h2&gt;飞向银河 · 银河航天年会主题舞曲&lt;/h2&gt;
&lt;p&gt;&lt;audio id=&#34;audio&#34; src=&#34;http://localhost:1313/jin.github.io/music/fly-to-the-galaxy.mp3&#34;&gt;&lt;/audio&gt;&lt;/p&gt;
  &lt;div class=&#34;controls&#34;&gt;
    &lt;button id=&#34;playBtn&#34;&gt;▶&lt;/button&gt;
    &lt;input type=&#34;range&#34; id=&#34;progress&#34; value=&#34;0&#34;&gt;
    &lt;span id=&#34;time&#34;&gt;0:00&lt;/span&gt;
  &lt;/div&gt;
  &lt;div class=&#34;lyrics&#34; id=&#34;lyrics&#34;&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;style&gt;
.galaxy-player {
  max-width: 720px;
  margin: 4rem auto;
  padding: 2.5rem;
  border-radius: 20px;
  background: linear-gradient(160deg, #0b1026, #1a1f3c);
  box-shadow: 0 0 40px rgba(100,150,255,.25);
  color: #fff;
  text-align: center;
}

.galaxy-player h1 {
  font-size: 2.2rem;
  letter-spacing: 2px;
}

.galaxy-player h2 {
  font-size: 1rem;
  opacity: .75;
  margin-bottom: 2rem;
}

.controls {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
}

.controls button {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: #4ea1ff;
  border: none;
  font-size: 1.2rem;
  color: #fff;
  cursor: pointer;
}

.controls input[type=&#34;range&#34;] {
  flex: 1;
}

.lyrics {
  height: 300px;
  overflow-y: auto;
  text-align: center;
  padding: 1rem;
  line-height: 2;
  font-size: 1.05rem;
}

.lyrics p {
  opacity: .4;
  transition: .3s;
}

.lyrics p.active {
  opacity: 1;
  color: #4ea1ff;
  font-size: 1.15rem;
}
&lt;/style&gt;
&lt;script&gt;
const audio = document.getElementById(&#34;audio&#34;);
const playBtn = document.getElementById(&#34;playBtn&#34;);
const progress = document.getElementById(&#34;progress&#34;);
const timeLabel = document.getElementById(&#34;time&#34;);
const lyricsBox = document.getElementById(&#34;lyrics&#34;);

let lyrics = [];

fetch(&#34;/music/fly-to-the-galaxy.lrc&#34;)
  .then(res =&gt; res.text())
  .then(text =&gt; {
    lyrics = text.split(&#34;\n&#34;).map(line =&gt; {
      const match = line.match(/\[(\d+):(\d+\.?\d*)\](.*)/);
      if (!match) return null;
      return {
        time: parseInt(match[1]) * 60 + parseFloat(match[2]),
        text: match[3]
      };
    }).filter(Boolean);

    lyrics.forEach(l =&gt; {
      const p = document.createElement(&#34;p&#34;);
      p.textContent = l.text;
      lyricsBox.appendChild(p);
    });
  });

playBtn.onclick = () =&gt; {
  if (audio.paused) {
    audio.play();
    playBtn.textContent = &#34;⏸&#34;;
  } else {
    audio.pause();
    playBtn.textContent = &#34;▶&#34;;
  }
};

audio.ontimeupdate = () =&gt; {
  progress.value = audio.currentTime / audio.duration * 100;
  timeLabel.textContent = formatTime(audio.currentTime);

  const ps = lyricsBox.querySelectorAll(&#34;p&#34;);
  lyrics.forEach((l, i) =&gt; {
    if (audio.currentTime &gt;= l.time &amp;&amp;
        (!lyrics[i+1] || audio.currentTime &lt; lyrics[i+1].time)) {
      ps.forEach(p =&gt; p.classList.remove(&#34;active&#34;));
      ps[i].classList.add(&#34;active&#34;);
      ps[i].scrollIntoView({behavior: &#34;smooth&#34;, block: &#34;center&#34;});
    }
  });
};

progress.oninput = () =&gt; {
  audio.currentTime = progress.value / 100 * audio.duration;
};

function formatTime(sec) {
  const m = Math.floor(sec / 60);
  const s = Math.floor(sec % 60).toString().padStart(2, &#34;0&#34;);
  return `${m}:${s}`;
}
&lt;/script&gt;
